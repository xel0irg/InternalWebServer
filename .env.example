# Bind address. 127.0.0.1 keeps the server reachable only from this machine.
# The hostname hub.internal.rg is mapped to this address in the Windows hosts file.
HOST=127.0.0.1

# Port 80 is the default for http://, so the URL needs no ":port" suffix.
# If port 80 is taken, use 8080 and browse to http://hub.internal.rg:8080
PORT=80

FLASK_DEBUG=1
